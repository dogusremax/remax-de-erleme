function exportCSV() {
  const headers = ["Tarih","Danışman","Mülk","Konum","Tip","Brüt m²","Tahmini Değer (TL)","USD","TL/m²","Aylık Kira","Yield %"];
  const rows = (state._allReports || []).map(r => [
    new Date(r.createdAt).toLocaleDateString("tr-TR"),
    r._advisor?.name || "",
    r.title || "", r.location || "", r.propertyType || "",
    r.grossM2 || "", r.estimatedValue || "", r.estimatedValueUsd || "",
    r.pricePerM2 || "", r.monthlyRent || "", r.grossYield || ""
  ]);
  const csv = [headers, ...rows].map(row => row.map(c => `"${String(c).replace(/"/g, '""')}"`).join(",")).join("\n");
  const blob = new Blob(["\uFEFF" + csv], { type: "text/csv;charset=utf-8;" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = `degerlemeler_${new Date().toISOString().slice(0,10)}.csv`;
  a.click();
  URL.revokeObjectURL(url);
}


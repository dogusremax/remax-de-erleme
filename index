<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RE/MAX Doğuş — Değerleme Stüdyosu</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/gh/gitbrent/pptxgenjs/dist/pptxgen.bundle.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<style>
:root {
  --dark: #0a0e1a;
  --mid: #13243a;
  --gold: #c9a961;
  --gold-dark: #a08442;
  --red: #DC1C2E;
  --red-dark: #b8162a;
  --blue: #003DA5;
  --green: #10b981;
  --text-light: #e8eaf0;
  --text-muted: #8b95a8;
  --text-faint: #5f6b7d;
  --border: rgba(255,255,255,0.08);
  --bg-card: rgba(255,255,255,0.03);
  --bg-card-hover: rgba(255,255,255,0.06);
}
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: 'Inter', system-ui, sans-serif;
  background: linear-gradient(135deg, #0a0e1a 0%, #131826 100%);
  color: var(--text-light);
  min-height: 100vh;
}
::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: var(--dark); }
::-webkit-scrollbar-thumb { background: #2a3548; border-radius: 4px; }
::-webkit-scrollbar-thumb:hover { background: #3a4660; }

@keyframes fadeUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
@keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
@keyframes pulse { 0%,100% { opacity: 0.4; } 50% { opacity: 0.9; } }
@keyframes spin { to { transform: rotate(360deg); } }
.fade-up { animation: fadeUp 0.5s ease-out forwards; }

/* LOGO */
.logo {
  display: inline-block;
  background-image: url('data:image/png;base64,');
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  width: 90px;
  height: 32px;
  vertical-align: middle;
}
.logo.large { width: 130px; height: 46px; }
.logo .red, .logo .blue { display: none; }

/* LAYOUT */
.page { padding: 24px; min-height: 100vh; }
.container { max-width: 1100px; margin: 0 auto; }
.container-narrow { max-width: 720px; margin: 0 auto; }
.container-thin { max-width: 560px; margin: 0 auto; }
.container-wide { max-width: 1200px; margin: 0 auto; }

/* TYPOGRAPHY */
h1.serif {
  font-family: 'Playfair Display', serif;
  font-weight: 900;
  letter-spacing: -0.02em;
  margin: 0;
  color: white;
}
.eyebrow {
  color: var(--gold);
  font-size: 11px;
  letter-spacing: 3px;
  text-transform: uppercase;
  font-weight: 600;
  margin: 0 0 8px;
}

/* BUTTONS */
button {
  font-family: inherit;
  cursor: pointer;
  border: none;
  border-radius: 10px;
  padding: 10px 14px;
  font-weight: 600;
  font-size: 13px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: all 0.15s;
}
button:disabled { cursor: not-allowed; opacity: 0.5; }
.btn-primary {
  background: linear-gradient(135deg, var(--red), var(--red-dark));
  color: white;
}
.btn-primary:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(220,28,46,0.3); }
.btn-secondary {
  background: rgba(201,169,97,0.12);
  color: var(--gold);
  border: 1px solid rgba(201,169,97,0.3);
}
.btn-ghost {
  background: rgba(255,255,255,0.05);
  color: #c4cad6;
  border: 1px solid var(--border);
}
.btn-ghost:hover { background: rgba(255,255,255,0.1); }

/* INPUTS */
input, textarea, select {
  font-family: inherit;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 10px;
  color: white;
  padding: 12px 14px;
  font-size: 14px;
  outline: none;
  width: 100%;
}
input:focus, textarea:focus, select:focus { border-color: rgba(201,169,97,0.5); }
textarea { resize: vertical; line-height: 1.6; }

/* CARDS */
.card {
  background: var(--bg-card);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 12px;
  padding: 18px;
  transition: all 0.2s;
}
.card-clickable { cursor: pointer; }
.card-clickable:hover {
  background: var(--bg-card-hover);
  border-color: rgba(201,169,97,0.3);
}

/* ADVISOR GRID */
.advisor-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 12px;
}
.advisor-btn {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 12px;
  padding: 18px 14px;
  text-align: left;
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--text-light);
  width: 100%;
}
.advisor-btn:hover {
  background: rgba(201,169,97,0.08);
  border-color: rgba(201,169,97,0.3);
  transform: translateY(-2px);
}
.advisor-avatar {
  width: 38px; height: 38px; border-radius: 50%;
  background: linear-gradient(135deg, var(--red), var(--blue));
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 14px;
  flex-shrink: 0;
  overflow: hidden;
}
.advisor-avatar img { width: 100%; height: 100%; object-fit: cover; }
.advisor-name { font-weight: 600; font-size: 14px; margin-bottom: 2px; }
.advisor-sub { font-size: 11px; color: var(--text-muted); }

/* HERO */
.hero-card {
  background: linear-gradient(135deg, rgba(220,28,46,0.1), rgba(201,169,97,0.1));
  border: 1px solid rgba(201,169,97,0.2);
  border-radius: 20px;
  padding: 36px 32px;
  margin-bottom: 24px;
}
.hero-value {
  font-family: 'Playfair Display', serif;
  font-size: 44px;
  font-weight: 900;
  color: white;
  line-height: 1;
  letter-spacing: -0.02em;
}

/* STAT CARD */
.stat-card {
  background: var(--bg-card);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 12px;
  padding: 18px;
  display: flex;
  align-items: center;
  gap: 14px;
}
.stat-icon {
  width: 44px; height: 44px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
}

/* PROGRESS */
.progress-bar {
  height: 3px;
  background: rgba(255,255,255,0.05);
  border-radius: 2px;
  overflow: hidden;
  position: relative;
}
.progress-bar::after {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  background-size: 200% 100%;
  animation: shimmer 2.5s linear infinite;
}

/* TABLE */
table { width: 100%; border-collapse: collapse; font-size: 13px; }
th { text-align: left; padding: 10px 12px; font-size: 11px; letter-spacing: 1px; color: var(--gold); font-weight: 600; text-transform: uppercase; border-bottom: 1px solid rgba(255,255,255,0.1); }
td { padding: 12px; color: var(--text-light); border-bottom: 1px solid rgba(255,255,255,0.04); }

/* SECTION */
.section { margin-bottom: 28px; }
.section-title {
  color: var(--gold);
  font-size: 11px;
  letter-spacing: 3px;
  text-transform: uppercase;
  font-weight: 600;
  margin: 0 0 14px;
}

/* HIDE */
.hidden { display: none !important; }

/* SCENARIO CARDS */
.scenarios { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
.scenario-card {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.08);
  border-top-width: 3px;
  border-radius: 12px;
  padding: 16px 18px;
}
.scenario-card.featured {
  background: rgba(220,28,46,0.08);
  border-color: var(--red);
}
.scenario-label { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; font-weight: 700; margin: 0 0 8px; }
.scenario-value { font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 800; color: white; margin: 0 0 6px; }
.scenario-cond { font-size: 12px; color: var(--text-muted); font-style: italic; }

/* PRESENTATION */
.pres-container { min-height: 100vh; background: #000; display: flex; flex-direction: column; }
.pres-bar {
  padding: 12px 20px;
  background: var(--dark);
  border-bottom: 1px solid rgba(255,255,255,0.05);
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.pres-stage { flex: 1; display: flex; align-items: center; justify-content: center; padding: 24px; overflow: auto; }
.slide {
  width: 100%;
  max-width: 1200px;
  aspect-ratio: 16/9;
  background: var(--dark);
  border-radius: 12px;
  overflow: hidden;
  position: relative;
  box-shadow: 0 30px 80px rgba(0,0,0,0.8);
  padding: 5% 6%;
  display: flex;
  flex-direction: column;
}
.slide.light { background: #f7f8fa; color: var(--dark); }
.slide-logo { position: absolute; top: 5%; right: 5%; }

/* MOBILE */
@media (max-width: 600px) {
  .page { padding: 16px; }
  .hero-card { padding: 24px 20px; }
}
</style>
</head>
<body>

<!-- ========== LOGIN VIEW ========== -->
<div id="view-login" class="page">
  <div class="fade-up" style="max-width: 900px; margin: 0 auto;">
    <div style="text-align: center; margin-bottom: 40px;">
      <div style="margin-bottom: 22px;">
        <div class="logo large">
          <div class="red">RE/MAX</div>
          <div class="blue">DOĞUŞ</div>
        </div>
      </div>
      <h1 class="serif" style="font-size: clamp(36px, 5vw, 56px); margin: 0 0 22px;
        background: linear-gradient(135deg, #fff, var(--gold));
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
        Değerleme Stüdyosu
      </h1>
      <p style="color: var(--text-muted); font-size: 16px; margin: 0; font-style: italic;">
        Yapay zeka destekli mülk değerleme ve sunum üretici
      </p>
      <div style="width: 80px; height: 2px; background: var(--gold); margin: 24px auto; opacity: 0.6;"></div>
    </div>

    <p style="text-transform: uppercase; font-size: 11px; letter-spacing: 4px;
      color: var(--gold); text-align: center; margin-bottom: 20px; font-weight: 600;">
      Danışman Seçimi
    </p>
    <div id="advisor-grid" class="advisor-grid"></div>

    <div style="text-align: center; margin-top: 40px; padding-top: 30px; border-top: 1px solid rgba(255,255,255,0.05);">
      <button onclick="showAdminLogin()" style="background: rgba(201,169,97,0.08); border: 1px solid rgba(201,169,97,0.2); color: var(--gold); padding: 10px 20px;">
        🛡️ Yönetici Girişi
      </button>
    </div>
  </div>
</div>

<!-- ========== ADMIN LOGIN ========== -->
<div id="view-admin-login" class="page hidden">
  <div class="fade-up" style="max-width: 400px; margin: 0 auto; text-align: center;">
    <div style="width: 70px; height: 70px; border-radius: 50%; background: linear-gradient(135deg, var(--gold), var(--gold-dark));
      display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 28px;">🛡️</div>
    <h1 class="serif" style="font-size: 32px; margin-bottom: 8px;">Yönetici Girişi</h1>
    <p style="color: var(--text-muted); margin-bottom: 28px; font-size: 14px;">PIN gir</p>
    <input type="password" id="admin-pin" placeholder="••••" maxlength="6"
      style="text-align: center; font-size: 24px; letter-spacing: 8px; padding: 16px; margin-bottom: 14px;"
      onkeydown="if(event.key==='Enter')checkAdminPin()">
    <div id="admin-error" class="hidden" style="color: #fca5a5; font-size: 13px; margin-bottom: 14px;"></div>
    <button onclick="checkAdminPin()" class="btn-primary" style="width: 100%; padding: 14px; font-size: 15px; justify-content: center;">Giriş Yap</button>
    <button onclick="showView('login')" class="btn-ghost" style="width: 100%; margin-top: 10px; padding: 12px; justify-content: center;">← Geri</button>
    <p style="margin-top: 28px; font-size: 11px; color: var(--text-faint);">Demo PIN: 1234</p>
  </div>
</div>

<!-- ========== ADMIN PANEL ========== -->
<div id="view-admin" class="page hidden">
  <div class="container-wide fade-up">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; flex-wrap: wrap; gap: 16px;">
      <div style="display: flex; align-items: center; gap: 14px;">
        <div class="logo"><div class="red">RE/MAX</div><div class="blue">DOĞUŞ</div></div>
        <div style="width: 1px; height: 24px; background: rgba(255,255,255,0.1);"></div>
        <span style="background: rgba(201,169,97,0.12); color: var(--gold); font-size: 11px; letter-spacing: 2px; padding: 5px 10px; border-radius: 6px; font-weight: 700; text-transform: uppercase;">🛡️ Yönetici</span>
      </div>
      <button onclick="showView('login')" class="btn-ghost">← Çıkış</button>
    </div>

    <h1 class="serif" style="font-size: clamp(32px, 4vw, 44px); margin-bottom: 28px;">Yönetici Paneli</h1>

    <div id="admin-stats" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin-bottom: 32px;"></div>
    <div id="admin-top-advisors" style="margin-bottom: 32px;"></div>

    <div style="display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap;">
      <input id="admin-search" type="text" placeholder="🔍 Mülk başlığı veya konum ara..." style="flex: 1; min-width: 200px;" oninput="renderAdminReports()">
      <select id="admin-filter" style="min-width: 200px;" onchange="renderAdminReports()">
        <option value="all">Tüm Danışmanlar</option>
      </select>
      <button onclick="exportCSV()" class="btn-secondary">📊 CSV İndir</button>
    </div>

    <div id="admin-reports"></div>
  </div>
</div>

<!-- ========== DASHBOARD ========== -->
<div id="view-dashboard" class="page hidden">
  <div class="container fade-up">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; flex-wrap: wrap; gap: 16px;">
      <div class="logo"><div class="red">RE/MAX</div><div class="blue">DOĞUŞ</div></div>
      <div style="display: flex; gap: 10px; align-items: center;">
        <button onclick="showView('profile')" class="btn-ghost" id="profile-btn">👤 Profilim</button>
        <button onclick="logout()" class="btn-ghost">🚪</button>
      </div>
    </div>

    <div style="margin-bottom: 36px;">
      <p class="eyebrow" id="welcome-text">Hoş geldin</p>
      <h1 class="serif" style="font-size: clamp(32px, 4vw, 44px); margin-bottom: 8px;">Yeni bir değerleme mi?</h1>
      <p style="color: var(--text-muted); margin: 0; font-size: 15px;">Mülk bilgilerini gir, yapay zeka raporu ve sunumu üretsin.</p>
    </div>

    <button onclick="showView('new')" style="
      width: 100%;
      background: linear-gradient(135deg, var(--red), var(--red-dark));
      border-radius: 16px; padding: 28px 32px; color: white;
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 40px; box-shadow: 0 10px 30px rgba(220,28,46,0.25);
      font-size: 14px;">
      <div style="display: flex; align-items: center; gap: 18px; text-align: left;">
        <div style="width: 56px; height: 56px; border-radius: 14px; background: rgba(255,255,255,0.15);
          display: flex; align-items: center; justify-content: center; font-size: 28px;">✨</div>
        <div>
          <div style="font-size: 22px; font-weight: 700; margin-bottom: 2px; font-family: 'Playfair Display', serif;">
            Yeni Değerleme Başlat
          </div>
          <div style="font-size: 13px; opacity: 0.85;">AI ile dakikalar içinde profesyonel rapor</div>
        </div>
      </div>
      <span style="font-size: 28px;">→</span>
    </button>

    <div>
      <p class="eyebrow" id="history-title">Geçmiş Değerlemeler</p>
      <div id="history-list"></div>
    </div>
  </div>
</div>

<!-- ========== PROFILE EDITOR ========== -->
<div id="view-profile" class="page hidden">
  <div class="container-thin fade-up">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <button onclick="showView('dashboard')" class="btn-ghost">← Geri</button>
      <div class="logo"></div>
    </div>
    <p class="eyebrow">Profilim</p>
    <h1 class="serif" style="font-size: 36px; margin-bottom: 32px;">Bilgilerimi Düzenle</h1>

    <div style="text-align: center; margin-bottom: 28px;">
      <label style="cursor: pointer; display: inline-block;">
        <div id="profile-photo-display" style="width: 110px; height: 110px; border-radius: 50%;
          background: linear-gradient(135deg, var(--red), var(--blue));
          display: flex; align-items: center; justify-content: center;
          font-weight: 700; font-size: 36px; color: white;
          border: 3px solid rgba(255,255,255,0.1); overflow: hidden;">
        </div>
        <input type="file" id="profile-photo-input" accept="image/*" style="display: none;" onchange="handleProfilePhoto(event)">
        <div style="margin-top: 12px; font-size: 12px; color: var(--gold);">📷 Fotoğraf Yükle/Değiştir</div>
      </label>
    </div>

    <div style="display: grid; gap: 14px;">
      <label>
        <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 6px;">👤 Ad Soyad</div>
        <input id="profile-name" type="text">
      </label>
      <label>
        <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 6px;">📞 Telefon</div>
        <input id="profile-phone" type="text" placeholder="0532 ...">
      </label>
      <label>
        <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 6px;">✉️ E-posta</div>
        <input id="profile-email" type="email">
      </label>
    </div>

    <button onclick="saveProfile()" class="btn-primary" style="width: 100%; margin-top: 24px; padding: 14px 24px; font-size: 15px; justify-content: center;">
      ✓ Kaydet
    </button>
  </div>
</div>

<!-- ========== NEW VALUATION ========== -->
<div id="view-new" class="page hidden">
  <div class="container-narrow fade-up">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <button onclick="showView('dashboard')" id="new-back-btn" class="btn-ghost">← Geri</button>
      <div class="logo"></div>
    </div>
    <p class="eyebrow">Yeni Değerleme</p>
    <h1 class="serif" style="font-size: clamp(32px, 4vw, 42px); margin-bottom: 12px;">Mülk Bilgileri</h1>
    <p style="color: var(--text-muted); margin-bottom: 28px; font-size: 14px;">
      Mülkün detaylarını bir paragraf halinde yaz. Konum, tip, m², kat, manzara, özellikler — ne kadar detay verirsen rapor o kadar isabetli olur.
    </p>

    <div id="new-form">
      <div id="new-error" class="hidden" style="background: rgba(220,28,46,0.1); border: 1px solid rgba(220,28,46,0.3); border-radius: 10px; padding: 14px; margin-bottom: 16px; color: #fca5a5; font-size: 13px;"></div>

      <textarea id="property-desc" rows="9"
        placeholder="Örnek: Anadolu Yakası Acıbadem'de Akasya Göl Etabı'nda 9 katlı binanın 4. katında, 3+1, brüt 155 m², net 110 m², ebeveyn banyolu, 20 m² teras balkonlu, göl manzaralı, kullanılmış ama boş bir daire..."></textarea>

      <div style="margin-top: 20px;">
        <p style="color: var(--text-muted); font-size: 12px; margin-bottom: 10px;">Mülk fotoğrafları (isteğe bağlı, sunumda kullanılır)</p>
        <div id="property-photos" style="display: flex; flex-wrap: wrap; gap: 8px;"></div>
      </div>

      <button onclick="generateValuation()" id="generate-btn" class="btn-primary" style="width: 100%; margin-top: 24px; padding: 16px 24px; font-size: 16px; justify-content: center;">
        ✨ Değerlemeyi Üret
      </button>
      <p style="text-align: center; color: var(--text-faint); font-size: 11px; margin-top: 12px;">
        En az 20 karakter girilmeli • Üretim ~30 saniye sürebilir
      </p>
    </div>

    <div id="new-generating" class="hidden" style="background: rgba(201,169,97,0.05); border: 1px solid rgba(201,169,97,0.2); border-radius: 16px; padding: 40px; text-align: center;">
      <div style="width: 60px; height: 60px; border-radius: 50%; background: rgba(201,169,97,0.15);
        display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;
        font-size: 28px; animation: pulse 1.5s ease-in-out infinite;">🪄</div>
      <div style="font-size: 18px; font-weight: 600; margin-bottom: 8px; font-family: 'Playfair Display', serif;">
        Değerleme Hazırlanıyor
      </div>
      <div id="progress-text" style="color: var(--text-muted); font-size: 14px;">Başlatılıyor...</div>
      <div class="progress-bar" style="margin-top: 24px;"></div>
    </div>
  </div>
</div>

<!-- ========== RESULT VIEW ========== -->
<div id="view-result" class="page hidden">
  <div class="container fade-up" id="result-content"></div>
</div>

<!-- ========== PRESENTATION VIEW ========== -->
<div id="view-presentation" class="pres-container hidden">
  <div class="pres-bar">
    <button onclick="showView('result')" class="btn-ghost">← Çıkış (Esc)</button>
    <span id="slide-counter" style="font-size: 13px; color: var(--text-muted);">1 / 8</span>
  </div>
  <div class="pres-stage">
    <div class="slide" id="slide-stage"></div>
  </div>

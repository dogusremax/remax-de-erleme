  btn.innerHTML = "📄 PDF İndir";
}

async function generatePDF(r, a) {
  const container = document.createElement("div");
  container.style.cssText = "width: 794px; padding: 40px; background: #fff; font-family: 'Helvetica', sans-serif; color: #0a0e1a;";
  container.innerHTML = `
    <div style="border-bottom: 3px solid #DC1C2E; padding-bottom: 16px; margin-bottom: 24px; display: flex; justify-content: space-between;">
      <div>
        <div style="font-size: 10px; letter-spacing: 4px; color: #c9a961; font-weight: 700; margin-bottom: 6px;">GAYRİMENKUL DEĞERLEME RAPORU</div>
        <h1 style="margin: 0; font-family: Georgia, serif; font-size: 26px;">${escapeHtml(r.title || "")}</h1>
        <div style="color: #5f6b7d; font-style: italic; margin-top: 4px;">${escapeHtml(r.location || "")}</div>
      </div>
      <div style="display: inline-flex; font-weight: 900;">
        <div style="background: #DC1C2E; color: white; padding: 6px 12px; font-size: 12px;">RE/MAX</div>
        <div style="background: #003DA5; color: white; padding: 6px 10px; font-size: 10px;">DOĞUŞ</div>
      </div>
    </div>
    <div style="background: linear-gradient(135deg, #DC1C2E, #b8162a); color: white; padding: 24px; border-radius: 12px; margin-bottom: 24px;">
      <div style="font-size: 10px; letter-spacing: 3px; opacity: 0.9; margin-bottom: 6px;">TAHMİNİ PİYASA DEĞERİ</div>
      <div style="font-family: Georgia, serif; font-size: 56px; font-weight: 900;">${formatTL(r.estimatedValue)}</div>
      <div style="font-size: 14px; font-style: italic; opacity: 0.85;">≈ $${(r.estimatedValueUsd||0).toLocaleString("en-US")} USD</div>
    </div>
    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; margin-bottom: 24px;">
      <div style="background: #f7f8fa; padding: 14px; border-radius: 8px; border-left: 3px solid #c9a961;"><div style="font-size: 10px; color: #5f6b7d;">TL/m²</div><div style="font-family: Georgia; font-size: 22px; font-weight: 700;">${formatTL(r.pricePerM2)}</div></div>
      <div style="background: #f7f8fa; padding: 14px; border-radius: 8px; border-left: 3px solid #c9a961;"><div style="font-size: 10px; color: #5f6b7d;">AYLIK KİRA</div><div style="font-family: Georgia; font-size: 22px; font-weight: 700;">${formatTL(r.monthlyRent)}</div></div>
      <div style="background: #f7f8fa; padding: 14px; border-radius: 8px; border-left: 3px solid #c9a961;"><div style="font-size: 10px; color: #5f6b7d;">YIELD</div><div style="font-family: Georgia; font-size: 22px; font-weight: 700;">%${(r.grossYield||0).toFixed(1)}</div></div>
    </div>
    ${r.marketAnalysis ? `<h2 style="font-family: Georgia; color: #DC1C2E;">PİYASA ANALİZİ</h2><p>${escapeHtml(r.marketAnalysis)}</p>` : ""}
    ${r.conclusion ? `<h2 style="font-family: Georgia; color: #DC1C2E;">SONUÇ</h2><p style="font-style: italic; color: #5f6b7d;">"${escapeHtml(r.conclusion)}"</p>` : ""}
    <div style="margin-top: 36px; padding-top: 16px; border-top: 1px solid #e2e8f0; font-size: 11px; color: #5f6b7d;">
      <b>${escapeHtml(a.name)}</b>${a.phone ? " • " + escapeHtml(a.phone) : ""}${a.email ? " • " + escapeHtml(a.email) : ""} | ${new Date(r.createdAt).toLocaleDateString("tr-TR")}
    </div>
  `;
  document.body.appendChild(container);
  try {
    const safeName = (r.title || "Degerleme").replace(/[^a-zA-Z0-9]/g, "_").slice(0, 40);
    await html2pdf().set({
      margin: 0,
      filename: `${safeName}_${Date.now()}.pdf`,
      image: { type: "jpeg", quality: 0.95 },
      html2canvas: { scale: 2, useCORS: true },
      jsPDF: { unit: "mm", format: "a4", orientation: "portrait" }
    }).from(container).save();
  } finally {
    document.body.removeChild(container);
  }
}

// ============ UTILS ============
function initials(name) {
  return name.split(" ").map(n => n[0]).join("").slice(0, 2).toUpperCase();
}
function formatTL(num) {
  if (!num || isNaN(num)) return "—";
  if (num >= 1000000) return `₺${(num/1000000).toFixed(num >= 10000000 ? 1 : 2).replace(".", ",")}M`;
  if (num >= 1000) return `₺${Math.round(num/1000)}K`;
  return `₺${num.toLocaleString("tr-TR")}`;
}
function escapeHtml(s) {
  if (s == null) return "";
  return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}


function nextSlide() { if (state.currentSlide < SLIDES.length - 1) { state.currentSlide++; renderSlide(); } }
function prevSlide() { if (state.currentSlide > 0) { state.currentSlide--; renderSlide(); } }

document.addEventListener("keydown", e => {
  if (state.view === "presentation") {
    if (e.key === "ArrowRight") nextSlide();
    if (e.key === "ArrowLeft") prevSlide();
    if (e.key === "Escape") showView("result");
  }
});

// ============ GAMMA & CANVA EXPORT ============
function buildPromptForAI(r, a) {
  const lines = [];
  lines.push(`# ${r.title || "Gayrimenkul Değerleme Raporu"}`);
  lines.push("");
  lines.push(`**Konum:** ${r.location || "—"}`);
  lines.push(`**Danışman:** ${a.name} (RE/MAX Doğuş)`);
  if (a.phone) lines.push(`**Telefon:** ${a.phone}`);
  if (a.email) lines.push(`**E-posta:** ${a.email}`);
  lines.push("");
  lines.push("## Tahmini Piyasa Değeri");
  lines.push(`- **Değer:** ${formatTL(r.estimatedValue)} (≈ ${(r.estimatedValueUsd||0).toLocaleString("en-US")} USD)`);
  lines.push(`- **Bant:** ${formatTL(r.lowEstimate)} – ${formatTL(r.highEstimate)}`);
  lines.push(`- **TL/m²:** ${formatTL(r.pricePerM2)}`);
  lines.push(`- **Aylık Kira:** ${formatTL(r.monthlyRent)}`);
  lines.push(`- **Brüt Yield:** %${(r.grossYield||0).toFixed(1)}`);
  lines.push("");
  lines.push("## Mülk Profili");
  if (r.propertyType) lines.push(`- Tip: ${r.propertyType}`);
  if (r.grossM2) lines.push(`- Brüt: ${r.grossM2} m²`);
  if (r.netM2) lines.push(`- Net: ${r.netM2} m²`);
  if (r.floor) lines.push(`- Kat: ${r.floor}`);
  if (r.view) lines.push(`- Manzara: ${r.view}`);
  if (r.condition) lines.push(`- Durum: ${r.condition}`);
  if (r.features?.length) lines.push(`- Özellikler: ${r.features.join(", ")}`);
  lines.push("");

  if (r.scenarios) {
    lines.push("## Üç Senaryo");
    lines.push(`- **Alt:** ${formatTL(r.scenarios.low.value)} — ${r.scenarios.low.condition}`);
    lines.push(`- **Orta (En Olası):** ${formatTL(r.scenarios.mid.value)} — ${r.scenarios.mid.condition}`);
    lines.push(`- **Üst:** ${formatTL(r.scenarios.high.value)} — ${r.scenarios.high.condition}`);
    lines.push("");
  }

  if (r.valueFactors?.length) {
    lines.push("## Değer Etkenleri");
    r.valueFactors.forEach(f => {
      lines.push(`- **${f.factor}** (${f.impact}): ${f.description}`);
    });
    lines.push("");
  }

  if (r.comparables?.length) {
    lines.push("## Emsal Karşılaştırma");
    r.comparables.forEach(c => {
      lines.push(`- ${c.type} • ${c.m2} m² • ${formatTL(c.price)} • ${formatTL(c.tlPerM2)}/m² — ${c.note || ""}`);
    });
    lines.push("");
  }

  if (r.marketAnalysis) {
    lines.push("## Piyasa Analizi");
    lines.push(r.marketAnalysis);
    lines.push("");
  }

  if (r.sellerStrategy?.length) {
    lines.push("## Satıcı Stratejisi");
    r.sellerStrategy.forEach(s => lines.push(`- ${s}`));
    lines.push("");
  }
  if (r.buyerStrategy?.length) {
    lines.push("## Alıcı Stratejisi");
    r.buyerStrategy.forEach(s => lines.push(`- ${s}`));
    lines.push("");
  }

  if (r.conclusion) {
    lines.push("## Sonuç");
    lines.push(r.conclusion);
  }

  return lines.join("\n");
}

async function exportToGamma() {
  const text = buildPromptForAI(state.currentReport, state.advisor);
  try {
    await navigator.clipboard.writeText(text);
  } catch (e) {
    // Fallback: textarea ile kopyala
    const ta = document.createElement("textarea");
    ta.value = text;
    document.body.appendChild(ta);
    ta.select();
    document.execCommand("copy");
    document.body.removeChild(ta);
  }
  // Açıklayıcı modal göster
  showCopyModal("Gamma", "https://gamma.app/create/generate", "🎨", "#8B5CF6");
}


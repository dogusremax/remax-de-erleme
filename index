async function generatePPTX(report, advisor) {
  const pres = new PptxGenJS();
  pres.layout = "LAYOUT_WIDE";

  const DARK = "0A0E1A", MID = "13243A", GOLD = "C9A961", RED = "DC1C2E", BLUE = "003DA5";
  const LIGHT = "F7F8FA", TEXT_LIGHT = "FFFFFF", TEXT_MUTED = "8B95A8", TEXT_DARK = "0A0E1A";

  function addLogo(slide, x = 11.5, y = 0.4) {
    slide.addShape(pres.shapes.RECTANGLE, { x, y, w: 0.85, h: 0.4, fill: { color: RED }, line: { type: "none" } });
    slide.addText("RE/MAX", { x, y, w: 0.85, h: 0.4, fontSize: 11, fontFace: "Arial Black", bold: true, color: "FFFFFF", align: "center", valign: "middle", margin: 0 });
    slide.addShape(pres.shapes.RECTANGLE, { x: x+0.85, y, w: 0.55, h: 0.4, fill: { color: BLUE }, line: { type: "none" } });
    slide.addText("DOĞUŞ", { x: x+0.85, y, w: 0.55, h: 0.4, fontSize: 8, fontFace: "Arial Black", bold: true, color: "FFFFFF", align: "center", valign: "middle", margin: 0 });
  }

  // Cover
  let s = pres.addSlide(); s.background = { color: DARK }; addLogo(s);
  s.addShape(pres.shapes.RECTANGLE, { x: 0.7, y: 0.7, w: 0.6, h: 0.04, fill: { color: GOLD }, line: { type: "none" } });
  s.addText("GAYRİMENKUL DEĞERLEME RAPORU", { x: 0.7, y: 0.9, w: 9, h: 0.35, fontSize: 11, fontFace: "Calibri", bold: true, color: GOLD, charSpacing: 6, margin: 0 });
  s.addText(report.title, { x: 0.7, y: 1.5, w: 12, h: 1.6, fontSize: 48, fontFace: "Georgia", bold: true, color: TEXT_LIGHT, valign: "middle", margin: 0 });
  s.addText(report.location || "", { x: 0.7, y: 3.2, w: 10, h: 0.4, fontSize: 18, fontFace: "Georgia", italic: true, color: TEXT_MUTED, margin: 0 });
  s.addText("TAHMİNİ PİYASA DEĞERİ", { x: 0.7, y: 4.6, w: 8, h: 0.3, fontSize: 11, fontFace: "Calibri", color: TEXT_MUTED, charSpacing: 4, margin: 0 });
  s.addText(formatTL(report.estimatedValue), { x: 0.7, y: 4.95, w: 12, h: 1.5, fontSize: 80, fontFace: "Georgia", bold: true, color: TEXT_LIGHT, valign: "middle", margin: 0 });
  s.addText(`≈ $${(report.estimatedValueUsd||0).toLocaleString("en-US")} USD`, { x: 0.7, y: 6.4, w: 8, h: 0.35, fontSize: 16, fontFace: "Georgia", italic: true, color: GOLD, margin: 0 });

  // Advisor
  s = pres.addSlide(); s.background = { color: LIGHT }; addLogo(s);
  s.addText("DANIŞMANINIZ", { x: 0.7, y: 0.7, w: 8, h: 0.35, fontSize: 11, bold: true, color: RED, charSpacing: 6, margin: 0 });
  if (advisor.photo) {
    try { s.addImage({ data: advisor.photo, x: 0.7, y: 1.6, w: 3.5, h: 4.4 }); } catch {}
  }
  s.addText(advisor.name, { x: 5, y: 1.8, w: 7.5, h: 1.0, fontSize: 44, fontFace: "Georgia", bold: true, color: TEXT_DARK, valign: "middle", margin: 0 });
  s.addText("Gayrimenkul Danışmanı", { x: 5, y: 2.85, w: 7.5, h: 0.4, fontSize: 16, fontFace: "Georgia", italic: true, color: "5F6B7D", margin: 0 });
  let cy = 3.5;
  if (advisor.phone) { s.addText("📞 " + advisor.phone, { x: 5, y: cy, w: 7.5, h: 0.5, fontSize: 15, color: TEXT_DARK, valign: "middle", margin: 0 }); cy += 0.5; }
  if (advisor.email) { s.addText("✉ " + advisor.email, { x: 5, y: cy, w: 7.5, h: 0.5, fontSize: 14, color: TEXT_DARK, valign: "middle", margin: 0 }); cy += 0.5; }
  s.addText("📍 RE/MAX Doğuş • Kadıköy, İstanbul", { x: 5, y: cy, w: 7.5, h: 0.5, fontSize: 14, color: TEXT_DARK, valign: "middle", margin: 0 });

  // Valuation
  s = pres.addSlide(); s.background = { color: DARK }; addLogo(s);
  s.addText("DEĞERLEME ÖZETİ", { x: 0.7, y: 0.7, w: 8, h: 0.35, fontSize: 11, bold: true, color: GOLD, charSpacing: 6, margin: 0 });
  s.addText("Tahmini Piyasa Değeri", { x: 0.7, y: 1.05, w: 12, h: 0.85, fontSize: 40, fontFace: "Georgia", bold: true, color: TEXT_LIGHT, margin: 0 });
  s.addShape(pres.shapes.RECTANGLE, { x: 0.7, y: 2.3, w: 7.2, h: 4.4, fill: { color: RED }, line: { type: "none" } });
  s.addText("TAHMİNİ DEĞER", { x: 1, y: 2.6, w: 6.8, h: 0.35, fontSize: 11, color: "FFFFFF", charSpacing: 4, margin: 0 });
  s.addText(formatTL(report.estimatedValue), { x: 1, y: 3.1, w: 6.8, h: 2.2, fontSize: 96, fontFace: "Georgia", bold: true, color: "FFFFFF", valign: "middle", margin: 0 });

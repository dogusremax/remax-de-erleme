  // Scenarios
  if (report.scenarios) {
    s = pres.addSlide(); s.background = { color: LIGHT }; addLogo(s);
    s.addText("SENARYO ANALİZİ", { x: 0.7, y: 0.7, w: 8, h: 0.35, fontSize: 11, bold: true, color: RED, charSpacing: 6, margin: 0 });
    s.addText("Üç Olası Çıktı", { x: 0.7, y: 1.05, w: 12, h: 0.85, fontSize: 40, fontFace: "Georgia", bold: true, color: TEXT_DARK, margin: 0 });
    const scs = [["ALT", "8B95A8", report.scenarios.low], ["ORTA • EN OLASI", RED, report.scenarios.mid], ["ÜST", "10B981", report.scenarios.high]];
    scs.forEach(([label, col, data], i) => {
      const x = 0.7 + i * 4.2;
      s.addShape(pres.shapes.RECTANGLE, { x, y: 2.4, w: 4, h: 4, fill: { color: "FFFFFF" }, line: { color: "E2E8F0", width: 1 } });
      s.addShape(pres.shapes.RECTANGLE, { x, y: 2.4, w: 4, h: 0.08, fill: { color: col }, line: { type: "none" } });
      s.addText(label, { x: x+0.3, y: 2.7, w: 3.4, h: 0.3, fontSize: 10, bold: true, color: col, charSpacing: 3, margin: 0 });
      s.addText(formatTL(data.value), { x: x+0.3, y: 3.2, w: 3.4, h: 1.5, fontSize: 40, fontFace: "Georgia", bold: true, color: TEXT_DARK, align: "center", valign: "middle", margin: 0 });
      s.addText(data.condition, { x: x+0.3, y: 4.8, w: 3.4, h: 1.5, fontSize: 12, color: "5F6B7D", italic: true, align: "center", valign: "top", margin: 0 });
    });
  }

  // Closing
  s = pres.addSlide(); s.background = { color: DARK }; addLogo(s);
  s.addText("SONUÇ", { x: 0.7, y: 0.7, w: 8, h: 0.35, fontSize: 11, bold: true, color: GOLD, charSpacing: 6, margin: 0 });
  s.addText("Karar Destek", { x: 0.7, y: 1.05, w: 12, h: 0.9, fontSize: 44, fontFace: "Georgia", bold: true, color: TEXT_LIGHT, margin: 0 });
  if (report.conclusion) {
    s.addText(`"${report.conclusion}"`, { x: 0.7, y: 2.1, w: 12, h: 1.0, fontSize: 16, fontFace: "Georgia", italic: true, color: "C4CAD6", margin: 0 });
  }

  const safeName = (report.title || "Degerleme").replace(/[^a-zA-Z0-9]/g, "_").slice(0, 40);
  pres.writeFile({ fileName: `${safeName}_${Date.now()}.pptx` });
}

